{
  "name": "ai-trainer-pwa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:budget": "node scripts/check-build-budget.mjs",
    "verify": "npm run lint && npm run typecheck && npm test -- --run && npm run build && npm run build:budget && npm run check-agents",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "node ./node_modules/vitest/vitest.mjs",
    "test:e2e": "playwright test",
    "audit:runtime": "npm audit --omit=dev",
    "verify:all": "npm run verify && npm run test:e2e && npm run audit:runtime",
    "check-agents": "bash ./check-agents.sh"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.0",
    "clsx": "^1.2.0",
    "date-fns": "^2.29.0",
    "dexie": "^3.2.0",
    "framer-motion": "^12.23.12",
    "i18next": "^22.4.0",
    "lucide-react": "^0.263.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.43.0",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^12.1.0",
    "react-router-dom": "^6.30.4",
    "recharts": "^3.1.2",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.20.0",
    "zustand": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.0.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.3.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.19",
    "tailwindcss": "^3.2.0",
    "typescript": "^4.9.0",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.6"
  }
}
